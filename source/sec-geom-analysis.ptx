              <m>
                y(0)=0
              </m>
            </p>
          </statement>
        </task>
        <task>
          <statement>
            <p>
              <m>
                y(-1)=0
              </m>
            </p>
          </statement>
        </task>
        <task>
          <statement>
            <p>
              <m>
                y(2)=2
              </m>
            </p>
          </statement>
        </task>
        <task>
          <statement>
            <p>
              <m>
                y(0)=-4
              </m>
            </p>
          </statement>
        </task>
      </exercise>
      <image source="./images/slopefield11.png" width="80%" />
    </page>
    <page>
      <p>
        Draw a phase line for the given autonomous differential equation and 
        label each equilibrium solution as a sink, source, or node.
      </p>
